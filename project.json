{
  "langrev": "1",
  "warnings": [ "no-unused" ],
  // lib/ vendors gpu.c3l (pinned submodule) and sdl3.c3l; gpu.c3l's own lib/
  // provides the vk/vma/spvreflect bindings via the second search path.
  "dependency-search-paths": [ "lib", "lib/gpu.c3l/lib" ],
  "dependencies": [ "gpu", "vk", "vma", "spvreflect" ],
  "output": "build",
  // windows-x64 vendors a static-CRT VMA static lib (VMA uses std::mutex);
  // the app must link the matching CRT or std::mutex layout mismatches crash
  // at first allocation. Harmless on linux (single libstdc++ ABI).
  "wincrt": "static",
  "targets": {
    // Windowed: SDL3 window + swapchain, presents the textured triangle.
    // Run with --frames N for an auto-exit smoke, --no-vsync for MAILBOX.
    "hello_triangle_sdl": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [ "hello_triangle_sdl/main.c3", "hello_triangle_sdl/hello_triangle_abi.c3", "shared/sample_window_sdl.c3", "shared/sample_args.c3", "shared/screenshot.c3", "shared/png.c3" ]
    },
    // Headless: no SDL. Proves the root-pointer compute ABI end to end.
    "root_pointer_compute": {
      "type": "executable",
      "sources": [ "root_pointer_compute/main.c3", "root_pointer_compute/root_pointer_abi.c3" ]
    },
    // Headless rasterization: textured triangles in dynamic viewport/scissor
    // regions, with readback verification and optional PNG capture.
    "offscreen_triangle": {
      "type": "executable",
      "sources": [ "offscreen_triangle/main.c3", "offscreen_triangle/offscreen_abi.c3", "shared/sample_args.c3", "shared/screenshot.c3", "shared/png.c3" ]
    },
    // Headless: writes a pattern into a storage image by TextureIndex, then
    // samples it back by the same index. Proves the bindless descriptor heap.
    "bindless_texture_compute": {
      "type": "executable",
      "sources": [ "bindless_texture_compute/main.c3", "bindless_texture_compute/bindless_abi.c3" ]
    },
    // Windowed: compute culls a quad grid and writes indirect draw args
    // (+ count where supported); one multi-draw renders via gl_DrawID.
    "textured_cube": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "textured_cube/main.c3", "textured_cube/textured_cube_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/sample_camera.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "texture_filtering": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "texture_filtering/main.c3", "texture_filtering/texture_filtering_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/sample_camera.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "volume_texture": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "volume_texture/main.c3", "volume_texture/volume_texture_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3",
        "shared/sample_args.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "bindless_stress": {
      "type": "executable",
      "sources": [ "bindless_stress/main.c3", "bindless_stress/bindless_stress_abi.c3" ]
    },
    "image_processing": {
      "type": "executable",
      "sources": [
        "image_processing/main.c3", "image_processing/image_processing_abi.c3",
        "shared/sample_args.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "particle_sim": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "particle_sim/main.c3", "particle_sim/particle_sim_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/sample_camera.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "frustum_culling": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "frustum_culling/main.c3", "frustum_culling/frustum_culling_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/sample_camera.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "shadow_mapping": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "shadow_mapping/main.c3", "shadow_mapping/shadow_mapping_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/sample_camera.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "deferred_shading": {
