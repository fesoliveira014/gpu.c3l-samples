        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/sample_camera.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "present_mode_explorer": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "present_mode_explorer/main.c3", "present_mode_explorer/present_mode_explorer_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "shared_selftest": {
      "type": "executable",
      "sources": [ "shared/selftest.c3", "shared/sample_args.c3", "shared/sample_camera.c3", "shared/png.c3" ]
    },
    "frame_upload_selftest": {
      "type": "executable",
      "sources": [ "shared/frame_upload_selftest.c3", "shared/frame_upload.c3" ]
    },
    "multithreaded_recording": {
      "type": "executable",
      "sources": [ "multithreaded_recording/main.c3", "multithreaded_recording/multithreaded_recording_abi.c3" ]
    },
    "pipeline_cache_timing": {
      "type": "executable",
