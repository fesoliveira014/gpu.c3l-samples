    },
    "memory_report": {
      "type": "executable",
      "sources": [ "memory_report/main.c3" ]
    },
    "gpu_driven_draw_sdl": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [ "gpu_driven_draw_sdl/main.c3", "gpu_driven_draw_sdl/gpu_driven_abi.c3", "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3", "shared/screenshot.c3", "shared/png.c3" ]
    },
    "minimal_triangle": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [ "minimal_triangle/main.c3", "shared/sample_window_sdl.c3", "shared/sample_args.c3", "shared/screenshot.c3", "shared/png.c3" ]
    },
    "mesh_shading": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "mesh_shading/main.c3", "mesh_shading/mesh_shading_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "stencil_mask": {
