    "skybox": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "skybox/main.c3", "skybox/skybox_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/sample_camera.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "compressed_textures": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "compressed_textures/main.c3", "compressed_textures/compressed_textures_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3", "shared/sample_args.c3",
        "shared/sample_camera.c3", "shared/screenshot.c3", "shared/png.c3"
      ]
    },
    "texture_streaming": {
      "type": "executable",
      "sources": [ "texture_streaming/main.c3", "texture_streaming/texture_streaming_abi.c3" ]
    },
    "cornell_box": {
      "type": "executable",
      "dependencies": [ "sdl3" ],
      "sources": [
        "cornell_box/main.c3", "cornell_box/cornell_box_abi.c3",
        "shared/sample_window_sdl.c3", "shared/frame_upload.c3",
